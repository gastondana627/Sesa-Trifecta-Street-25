# --- Flask Configuration ---
PORT=5001
DEBUG=True

# --- Google Cloud Vertex AI Configuration ---
# Path to your Google service account key file
GOOGLE_APPLICATION_CREDENTIALS=backend/service-account-key.json

# --- AI Backend Fallback (LM Studio) ---
# URL for the local LM Studio server
LM_STUDIO_URL=http://localhost:1234/v1/chat/completions

# --- Neo4j IAM Configuration ---
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-super-secret-password
